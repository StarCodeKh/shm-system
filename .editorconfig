# Code style shared by all editors (https://editorconfig.org)
# Line endings are not set here: the repository has both CRLF and LF files, each keeps its own.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
