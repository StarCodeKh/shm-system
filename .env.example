# Copy to .env and fill in the values for this machine. Never commit .env.

# --- Application ------------------------------------------------------------
APP_NAME="SHM System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Phnom_Penh
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------------
# Tables are created with: php artisan migrate
# Copying data from an old database: DB_DATABASE=<new> php artisan db:transfer-legacy <old>
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shm_system_db
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=tbl_

# --- Cache, session, queue --------------------------------------------------
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# --- Audit log ------------------------------------------------------------------
AUDITING_ENABLED=true

# --- Firebase / push notifications --------------------------------------------
# Paths to the service-account JSON files (keep them outside git, e.g. storage/firebase/)
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=shm-app-ccb29
SERVICE_ACCOUNT_KEY_PATH=
FCM_SCOPE="https://www.googleapis.com/auth/firebase.messaging"
FCM_SENDER_ID=

# --- Optional services (leave empty if unused) ------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
